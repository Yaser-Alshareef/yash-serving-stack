# Copy to .env and adjust. compose reads .env automatically; .env is
# gitignored, .env.example is committed. Authored in W2D5.

# Default Compose image.
IMAGE=yas1er/aidc-serving:cpuv2

# Which model the service loads and reports.
MODEL_ID=Qwen2.5-1.5B-Instruct

# Host port the service publishes on (the container side stays 8000).
HOST_PORT=8000

# The host model directory is mounted read-only into the container.
MODEL_PATH=/models/Qwen2.5-1.5b
LOCAL_FILES_ONLY=true

# Key for the X-API-Key header used by /v1/*.
API_KEY=changeme

# Hard ceiling on max_tokens per request.
MAX_TOKENS=256
